---
import Layout from '../layouts/Layout.astro';
import Testimonials from '../components/Testimonials.astro';
import SchemaService from '../components/SchemaService.astro';

const title = 'Local SEO for Lawyers, Dentists & Clinics — Rivigrowth';
const description =
  'Local SEO that brings booked appointments and ringing phones — not just rankings. One client per niche per city. Plans from $2,000/mo.';
const canonical = 'https://rivigrowth.com/local-business';

const industries = [
  { name: 'Lawyers', sub: 'Personal injury, family, criminal, estate' },
  { name: 'Dentists', sub: 'General, pediatric, orthodontics, implants' },
  { name: 'Medical clinics', sub: 'Primary care, specialist, urgent care' },
  { name: 'Med spas', sub: 'Aesthetics, derm, wellness, plastic surgery' },
  { name: 'Chiropractors', sub: 'Sports, family, decompression' },
  { name: 'Physical therapy', sub: 'Sports rehab, post-op, geriatric' },
];

const stack = [
  { tag: 'Foundation', t: 'Google Business Profile', b: 'End-to-end optimization. Photos, services, products, posts, Q&A, attributes — all the levers most local businesses ignore.' },
  { tag: 'Authority', t: 'Citations & directories', b: 'Building and cleaning up NAP citations across the directories Google actually trusts. No spam directory blast.' },
  { tag: 'Reputation', t: 'Reviews engine', b: 'A repeatable workflow that gets your happy patients to leave 5-star reviews — and a process to handle the occasional bad one.' },
  { tag: 'Content', t: 'Local landing pages', b: 'Pages that target "[service] in [city]" and the long-tail neighborhood queries your competitors aren’t bidding on.' },
  { tag: 'Backlinks', t: 'Local link building', b: 'Backlinks from local press, chambers, sponsorships, and niche-relevant sites in your metro. Real signals, not PBNs.' },
  { tag: 'On-page', t: 'On-page & technical SEO', b: 'Title tags, meta, schema, internal linking, site speed and mobile UX — the boring fundamentals that hold the rest in place.' },
];
---

<Layout title={title} description={description} canonical={canonical}>
  <SchemaService
    slot="head"
    name="Local SEO Services"
    description="Local SEO for service businesses including lawyers, dentists, and medical clinics. Optimized for booked appointments, not vanity rankings."
    serviceType="Local Search Engine Optimization"
    url={canonical}
  />

  {/* HERO — split with a fake Google "local pack" preview on the right */}
  <section class="container-content pt-16 md:pt-24 pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 reveal">
        <p class="eyebrow eyebrow-accent mb-5">Local SEO · service businesses</p>
        <h1 class="h-hero">
          Get your phone ringing. <span class="italic-accent" style="color: var(--accent);">Not just your rankings.</span>
        </h1>
        <p class="lead mt-7 max-w-xl">
          Local SEO for lawyers, dentists, and clinics that need booked appointments — not just better positions on a vanity dashboard.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href="/contact" class="btn-primary">Book a free strategy call <span aria-hidden="true">→</span></a>
          <a href="/pricing" class="btn-outline">See pricing</a>
        </div>
        <p class="mt-7 inline-flex items-center gap-2 text-[14px] px-4 py-2" style="border: 1px solid var(--accent); color: var(--text); border-radius: 999px;">
          <span class="w-2 h-2 rounded-full" style="background: var(--accent);" aria-hidden="true"></span>
          One client per niche per city — guaranteed
        </p>
      </div>

      {/* Mock local pack result card */}
      <div class="lg:col-span-5 reveal" style="--reveal-delay: 150ms;">
        <div class="card p-6" style="background: var(--bg-cream);">
          <p class="eyebrow eyebrow-accent mb-3">Google · local pack</p>
          <p class="text-[13px]" style="color: var(--text-muted);">"dentist near me"</p>

          <div class="mt-4 space-y-3">
            {[1, 2, 3].map((i) => (
              <div class="p-4" style={`background: var(--bg); border: 1px solid var(--border); border-radius: 6px; ${i === 1 ? 'box-shadow: 0 0 0 2px var(--accent);' : ''}`}>
                <div class="flex items-baseline justify-between gap-3">
                  <p class="font-semibold text-[14px]">{i === 1 ? 'Your practice' : `Competitor ${i - 1}`}</p>
                  <span class="text-[12px]" style="color: var(--text-muted);">★ {(5 - (i - 1) * 0.2).toFixed(1)}</span>
                </div>
                <div class="mt-1 flex items-center gap-2 text-[12px]" style="color: var(--text-muted);">
                  <span style="color: var(--green);">●</span>
                  <span>Open · 0.4 mi · {i === 1 ? '(312) 555-0142' : '(312) 555-01XX'}</span>
                </div>
                {i === 1 && (
                  <p class="mt-2 text-[11px] font-semibold" style="color: var(--accent);">
                    ↑ #1 within 90 days of Rivigrowth
                  </p>
                )}
              </div>
            ))}
          </div>

          <p class="mt-5 text-[12px]" style="color: var(--text-muted);">
            Real shape of the local pack we optimize for. Numbers are illustrative.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* INDUSTRIES — distinct grid not on homepage */}
  <section class="section-cream">
    <div class="container-content py-20 md:py-24">
      <div class="max-w-3xl">
        <p class="eyebrow eyebrow-accent mb-4">Industries we serve</p>
        <h2 class="h-section">Service businesses where <span class="italic-accent" style="color: var(--accent);">a phone call is a customer.</span></h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 mt-12">
        {industries.map((i) => (
          <article class="card p-6 h-full" style="background: var(--bg);">
            <p class="font-bold text-[18px]">{i.name}</p>
            <p class="mt-2 text-[13px]" style="color: var(--text-muted);">{i.sub}</p>
          </article>
        ))}
      </div>

      <p class="mt-8 text-[14px]" style="color: var(--text-muted);">
        Don’t see your industry? <a href="/contact" class="link-underline font-semibold" style="color: var(--text);">Ask us if we’re a fit →</a>
      </p>
    </div>
  </section>

  {/* THE STACK — 6 services in 3x2 grid (different from homepage 4-step process) */}
  <section class="container-content py-24 md:py-32">
    <div class="max-w-3xl">
      <p class="eyebrow eyebrow-accent mb-4">Our local SEO stack</p>
      <h2 class="h-section">Six pieces. <span class="italic-accent" style="color: var(--accent);">All built around bookings.</span></h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-16">
      {stack.map((s) => (
        <article class="card p-7 h-full">
          <p class="eyebrow eyebrow-accent">{s.tag}</p>
          <h3 class="h-sub mt-3" style="font-size: 22px;">{s.t}</h3>
          <p class="mt-3 text-[14px]" style="color: var(--text-muted);">{s.b}</p>
        </article>
      ))}
    </div>
  </section>

  {/* PAIN — dark section, 3 columns */}
  <section class="section-dark">
    <div class="container-content py-20 md:py-24">
      <div class="max-w-3xl">
        <p class="eyebrow eyebrow-accent mb-4">If this sounds familiar</p>
        <h2 class="h-section" style="color: var(--text-dark-bg);">
          You’re losing patients <span class="italic-accent" style="color: var(--accent);">to worse competitors.</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
        {[
          { t: 'Page 2 while competitors get the calls', b: 'Your service is better. Your reviews say so. But "[your service] near me" goes to a competitor with a cleaner Google Business Profile.' },
          { t: 'Money wasted on agencies that don’t get local', b: 'You’ve paid four figures a month for generic content and Ads. Nobody touched your GBP, your citations, or your local backlinks.' },
          { t: 'GBP and reviews sitting unmanaged', b: 'Last review three months ago. Photos from 2021. Q&A unanswered. The biggest free local SEO lever you have, completely ignored.' },
        ].map((p) => (
          <article class="card-dark p-7 h-full">
            <h3 class="font-semibold text-[18px]" style="color: var(--text-dark-bg);">{p.t}</h3>
            <p class="mt-3 text-[14px]" style="color: var(--text-dark-bg-muted);">{p.b}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* HOW WE START — vertical timeline (different from horizontal cards on homepage) */}
  <section class="container-content py-24 md:py-32">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-4">
        <p class="eyebrow eyebrow-accent mb-4">Your first 90 days</p>
        <h2 class="h-section">From signed to <span class="italic-accent" style="color: var(--accent);">ringing.</span></h2>
        <p class="lead mt-5">
          Local SEO is one of the fastest channels — most clients see new calls in 60–90 days.
        </p>
      </div>

      <ol class="lg:col-span-8 space-y-0" style="border-top: 1px solid var(--border);">
        {[
          { week: 'Week 1', t: 'Audit & access', b: 'Full audit of your site, GBP, citations, and competitors. We get access to everything we need to run.' },
          { week: 'Week 2', t: 'GBP overhaul', b: 'Photos, services, products, posts, attributes. We rebuild your profile to maximize local pack placement.' },
          { week: 'Weeks 3–4', t: 'Citation cleanup + first local pages', b: 'Major citations cleaned and built. First two "[service] in [city]" pages shipped and indexed.' },
          { week: 'Month 2', t: 'Reviews engine + content rolling', b: 'Review-generation workflow live. 4 new local pages shipped. First batch of local backlinks earned.' },
          { week: 'Month 3', t: 'Report, expand, repeat', b: 'First full report shows what’s moving. We double down on the pages, citations, and link sources that are working.' },
        ].map((s) => (
          <li class="grid grid-cols-12 gap-6 py-6" style="border-bottom: 1px solid var(--border);">
            <p class="col-span-12 md:col-span-3 eyebrow eyebrow-accent self-start">{s.week}</p>
            <div class="col-span-12 md:col-span-9">
              <p class="font-semibold text-[17px]">{s.t}</p>
              <p class="mt-2 text-[15px]" style="color: var(--text-muted);">{s.b}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* TESTIMONIAL */}
  <Testimonials
    label="What local clients say"
    heading="Booked appointments. That’s the metric."
    testimonials={[{
      quote: 'Drop a real local-client testimonial here — focused on phone calls or booked appointments rather than rankings.',
      name: 'Client name',
      role: 'Owner · Local practice',
      result: '+38 calls/mo',
    }]}
  />

  {/* FINAL CTA */}
  <section class="section-dark">
    <div class="container-content py-24 md:py-32">
      <div class="max-w-4xl">
        <p class="eyebrow eyebrow-accent mb-5">Ready to ring?</p>
        <h2 class="h-section" style="color: var(--text-dark-bg);">
          If we’re a fit, we’ll tell you. <span class="italic-accent" style="color: var(--accent);">If not, we’ll point you somewhere better.</span>
        </h2>
        <p class="lead mt-6" style="color: var(--text-dark-bg-muted);">
          Free 30-minute call. Both founders on the line. We tell you exactly what we’d do in your first 90 days.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href="/contact" class="btn-primary">Book a free strategy call <span aria-hidden="true">→</span></a>
          <a href="/saas" class="btn-on-dark">See SaaS SEO</a>
          <a href="/pricing" class="btn-on-dark">See pricing</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
