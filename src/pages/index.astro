---
import Layout from '../layouts/Layout.astro';
import Testimonials from '../components/Testimonials.astro';
import GSCChart from '../components/GSCChart.astro';
import SchemaFAQ from '../components/SchemaFAQ.astro';

const title = 'Rivigrowth — The Best SEO Agency for Local Business & SaaS';
const description =
  'Founder-led SEO agency. We rank local businesses and SaaS companies for the keywords that drive revenue. Plans from $2,000/mo.';
const canonical = 'https://rivigrowth.com/';

const trustLogos = [
  'TechCrunch', 'Forbes', 'G2', 'Clutch', 'Product Hunt', 'Indie Hackers',
];

const niches = [
  {
    eyebrow: 'For local businesses',
    title: 'Lawyers, dentists & clinics',
    body: 'You depend on phone calls and booked appointments. We rank you in the local pack and turn Google Business Profile into a lead engine.',
    points: ['Local pack rankings', 'GBP optimization', 'Citation cleanup', 'Review generation'],
    href: '/local-business',
    cta: 'See local SEO →',
  },
  {
    eyebrow: 'For SaaS founders',
    title: 'Early-stage to scale-up',
    body: 'BoFu first. We rank you for "[competitor] alternative", "best [category] software", and integration queries — the searches that pay back.',
    points: ['BoFu keyword strategy', 'Comparison & integration pages', 'Programmatic SEO', 'Conversion-tracked'],
    href: '/saas',
    cta: 'See SaaS SEO →',
  },
];
---

<Layout title={title} description={description} canonical={canonical}>
  {/* ============ HERO ============ */}
  <section class="relative overflow-hidden">
    <div class="container-content pt-16 md:pt-24 pb-20 md:pb-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
        <div class="lg:col-span-8 reveal">
          <p class="eyebrow eyebrow-accent mb-5">
            SEO Agency · Local business + SaaS
          </p>

          <h1 class="h-hero">
            Rank for the keywords that <span class="italic-accent" style="color: var(--accent);">grow your revenue</span>.
          </h1>

          <p class="lead mt-7 max-w-xl">
            Two senior operators. Done-with-you SEO that turns Google into your top revenue channel — without retainers you can’t escape.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-4">
            <a href="/contact" class="btn-primary">Book a free strategy call <span aria-hidden="true">→</span></a>
            <a href="/pricing" class="btn-outline">See pricing</a>
          </div>

          <div class="mt-9 flex items-center gap-4">
            <div class="flex" style="gap: 2px;" aria-hidden="true">
              {[1,2,3,4,5].map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#D4633A"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
            </div>
            <p class="text-[14px]" style="color: var(--text-muted);">
              Trusted by founders who care about revenue, not vanity metrics
            </p>
          </div>
        </div>

        {/* Hero stat card */}
        <div class="lg:col-span-4 reveal" style="--reveal-delay: 150ms;">
          <div class="card p-8" style="background: var(--bg-cream);">
            <p class="eyebrow eyebrow-accent">Live result</p>
            <p class="h-stat mt-3" style="font-size: clamp(48px, 6vw, 72px);">+54%</p>
            <p class="mt-2 text-[15px] font-medium">organic clicks in 90 days</p>
            <hr class="hairline my-6" />
            <ul class="text-[14px] space-y-3" style="color: var(--text-muted);">
              <li class="flex justify-between"><span>Clicks</span><strong style="color: var(--text);">96.2K</strong></li>
              <li class="flex justify-between"><span>Impressions</span><strong style="color: var(--text);">6.82M</strong></li>
              <li class="flex justify-between"><span>Avg position</span><strong style="color: var(--text);">7.4 <span style="color: var(--green);">▲</span></strong></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ============ TRUST STRIP (DARK) ============ */}
  <section class="section-dark">
    <div class="container-content py-10 md:py-12">
      <p class="eyebrow text-center mb-8" style="color: var(--text-dark-bg-muted);">
        Featured in & trusted by
      </p>
      <div class="grid grid-cols-3 md:grid-cols-6 gap-x-8 gap-y-6 items-center">
        {trustLogos.map((name) => (
          <p
            class="text-center font-semibold tracking-wider opacity-60"
            style="color: var(--text-dark-bg); font-size: 14px; letter-spacing: 0.06em;"
          >
            {name}
          </p>
        ))}
      </div>
    </div>
  </section>

  {/* ============ BIG STATS ============ */}
  <section class="container-content py-24 md:py-32">
    <div class="max-w-3xl">
      <p class="eyebrow eyebrow-accent mb-4">Real results, real Google data</p>
      <h2 class="h-section">
        90 days of focused SEO. <span class="italic-accent" style="color: var(--accent);">Same site, same product.</span>
      </h2>
      <p class="lead mt-5">
        What a real Search Console report looks like when you focus on commercial-intent keywords and remove the random blog content.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-0 mt-16" style="border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);">
      {[
        { v: '96.2K', l: 'organic clicks', d: '+54% vs prev 90 days' },
        { v: '6.82M', l: 'search impressions', d: '+45% vs prev 90 days' },
        { v: '7.4', l: 'avg. position', d: 'pulled up from 8.0' },
      ].map((s, i) => (
        <div
          class="py-10 md:py-12 px-2 md:px-8"
          style={i < 2 ? 'border-right: 1px solid var(--border);' : ''}
        >
          <p class="h-stat" style="color: var(--text);">{s.v}</p>
          <p class="mt-3 text-[16px] font-semibold">{s.l}</p>
          <p class="mt-1 text-[13px]" style="color: var(--text-muted);">{s.d}</p>
        </div>
      ))}
    </div>

    <div class="mt-16">
      <GSCChart />
    </div>

    <div class="mt-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <p class="text-[14px]" style="color: var(--text-muted);">
        Want this on your site?
      </p>
      <a href="/contact" class="btn-dark">
        Book a free strategy call <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  {/* ============ TWO NICHES ============ */}
  <section class="section-cream">
    <div class="container-content py-24 md:py-32">
      <div class="max-w-3xl">
        <p class="eyebrow eyebrow-accent mb-4">Who we work with</p>
        <h2 class="h-section">Two niches. One playbook that actually works.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-16">
        {niches.map((n) => (
          <article class="card card-hover p-8 md:p-10">
            <p class="eyebrow eyebrow-accent">{n.eyebrow}</p>
            <h3 class="h-sub mt-3">{n.title}</h3>
            <p class="mt-4 text-[16px]" style="color: var(--text-muted);">{n.body}</p>
            <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-2 text-[14px]">
              {n.points.map((p) => (
                <li class="flex items-baseline gap-2">
                  <span style="color: var(--accent);" aria-hidden="true">●</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
            <a href={n.href} class="link-underline mt-8 inline-block text-[14px] font-semibold">
              {n.cta}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ============ PROCESS ============ */}
  <section class="container-content py-24 md:py-32">
    <div class="max-w-3xl">
      <p class="eyebrow eyebrow-accent mb-4">How we work</p>
      <h2 class="h-section">Four steps. No fluff. No fillers.</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-16">
      {[
        { n: '01', t: 'Audit', b: 'We tear apart your site, your backlink profile, and your competitors. You get a real list of leaks.' },
        { n: '02', t: 'Strategy', b: 'A 90-day roadmap of pages, links, and fixes — prioritized by revenue impact, not by what we feel like doing.' },
        { n: '03', t: 'Execute', b: 'Content, links, technical fixes — done by us. No junior handoffs. No offshore writers. Just the work.' },
        { n: '04', t: 'Report', b: 'Monthly numbers that matter: rankings, clicks, leads. Tied to revenue inside your CRM, not slide theater.' },
      ].map((s) => (
        <article class="card p-7 h-full">
          <p class="eyebrow eyebrow-accent">{s.n}</p>
          <h3 class="h-sub mt-3" style="font-size: 22px;">{s.t}</h3>
          <p class="mt-3 text-[14px]" style="color: var(--text-muted);">{s.b}</p>
        </article>
      ))}
    </div>
  </section>

  {/* ============ DELIVERABLES ============ */}
  <section class="section-cream">
    <div class="container-content py-24 md:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-5">
          <p class="eyebrow eyebrow-accent mb-4">What you actually get</p>
          <h2 class="h-section">Real deliverables. <span class="italic-accent" style="color: var(--accent);">Counted, not promised.</span></h2>
          <p class="lead mt-5">
            Every plan ships specific deliverables every month. We tell you the number; you see the number in the report.
          </p>
          <a href="/pricing" class="btn-dark mt-8">See plans & pricing <span aria-hidden="true">→</span></a>
        </div>

        <ul class="lg:col-span-7 space-y-0" style="border-top: 1px solid var(--border);">
          {[
            ['Articles', 'Written and published end-to-end'],
            ['Backlinks', 'Built from real sites in your niche'],
            ['On-page', 'Optimization for your highest-intent pages'],
            ['Technical', 'Site speed, JS rendering, internal linking'],
            ['Reporting', 'Monthly performance tied to revenue'],
            ['Strategy', 'Bi-weekly or weekly calls based on plan'],
          ].map(([k, v]) => (
            <li class="flex items-baseline justify-between py-5 gap-6" style="border-bottom: 1px solid var(--border);">
              <div class="flex items-baseline gap-6 min-w-0">
                <span class="eyebrow eyebrow-accent" style="min-width: 110px;">{k}</span>
                <span class="text-[16px]">{v}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ============ TESTIMONIAL ============ */}
  <Testimonials
    label="What clients say"
    heading="Real founders. Real numbers."
    testimonials={[{
      quote: 'Drop your real client testimonial here when ready. The card is built — swap the quote, name, role, and result number, and you’re live.',
      name: 'Client name',
      role: 'Founder · Company',
      result: '+54%',
    }]}
  />

  {/* ============ TEAM (no names, just roles) ============ */}
  <section class="container-content py-24 md:py-32">
    <div class="max-w-3xl">
      <p class="eyebrow eyebrow-accent mb-4">Who you’ll actually work with</p>
      <h2 class="h-section">Two senior operators. <span class="italic-accent" style="color: var(--accent);">No agency layers.</span></h2>
      <p class="lead mt-5">
        You hire us. You talk to us. We do the work. That’s it.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-16">
      {[
        {
          tag: '01',
          role: 'Strategy, technical & link building',
          bio: 'Twelve years ranking sites in some of the most competitive niches on the internet. Owns audits, keyword strategy, technical fixes, and the backlink program.',
        },
        {
          tag: '02',
          role: 'Content, on-page & conversion',
          bio: 'Eight years writing content that ranks and sells. Owns the editorial pipeline, on-page optimization, and conversion copy.',
        },
      ].map((p) => (
        <article class="card p-8 md:p-10">
          <p class="eyebrow eyebrow-accent">{p.tag} — Rivigrowth team</p>
          <h3 class="h-sub mt-3">{p.role}</h3>
          <p class="mt-4 text-[15px]" style="color: var(--text-muted);">{p.bio}</p>
        </article>
      ))}
    </div>
  </section>

  {/* ============ FAQ ============ */}
  <section class="section-cream">
    <div class="container-content py-24 md:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-4">
          <p class="eyebrow eyebrow-accent mb-4">FAQ</p>
          <h2 class="h-section">Common questions.</h2>
        </div>
        <div class="lg:col-span-8 space-y-0" style="border-top: 1px solid var(--border);">
          {[
            { q: 'Who is Rivigrowth for?', a: 'Local service businesses (lawyers, dentists, clinics) and SaaS companies that want SEO done by senior operators, not by a junior at a layered agency.' },
            { q: 'How much does it cost?', a: 'Plans start at $2,000/month with a 3-month minimum. Most clients land on the $4,000/month Growth plan. There’s a one-time $500 onboarding fee.' },
            { q: 'How long until I see results?', a: 'Local SEO typically shows in 60–90 days. SaaS SEO typically shows in 4–6 months. Monthly reports show the trajectory before traffic compounds.' },
            { q: 'Do you take retainers I can’t escape?', a: 'No. 3-month minimum to make sure we have time to ship something real. After that, month-to-month — leave any time.' },
          ].map((f) => (
            <details class="py-6" style="border-bottom: 1px solid var(--border);">
              <summary class="cursor-pointer flex items-start justify-between gap-6 list-none font-semibold text-[17px]" style="color: var(--text);">
                <span>{f.q}</span>
                <span aria-hidden="true" style="color: var(--accent); font-size: 22px; line-height: 1;">+</span>
              </summary>
              <p class="mt-4 text-[15px]" style="color: var(--text-muted);">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ============ FINAL CTA (DARK) ============ */}
  <section class="section-dark">
    <div class="container-content py-24 md:py-32">
      <div class="max-w-4xl">
        <p class="eyebrow eyebrow-accent mb-5">Ready to grow?</p>
        <h2 class="h-section" style="color: var(--text-dark-bg);">
          Let’s grow your organic traffic — <span class="italic-accent" style="color: var(--accent);">starting this month.</span>
        </h2>
        <p class="lead mt-6" style="color: var(--text-dark-bg-muted);">
          Free 30-minute strategy call. Both founders on the call. Honest answer on whether we’re a fit.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href="/contact" class="btn-primary">Book a free strategy call <span aria-hidden="true">→</span></a>
          <a href="/pricing" class="btn-on-dark">See pricing</a>
        </div>
      </div>
    </div>
  </section>

  <SchemaFAQ
    slot="head"
    faqs={[
      { question: 'Who is Rivigrowth for?', answer: 'Local service businesses (lawyers, dentists, clinics) and SaaS companies who want SEO done by senior operators, not by a junior at a layered agency.' },
      { question: 'How much does it cost?', answer: 'Plans start at $2,000/month with a 3-month minimum. Most clients land on the $4,000/month Growth plan. There is a one-time $500 onboarding fee.' },
      { question: 'How long until I see results?', answer: 'Local SEO typically shows in 60-90 days. SaaS SEO typically shows in 4-6 months. We share monthly reports so you can see the trajectory before traffic compounds.' },
      { question: 'Do you take retainers I cannot escape?', answer: 'No. 3-month minimum, then month-to-month. Leave any time.' },
    ]}
  />
</Layout>
