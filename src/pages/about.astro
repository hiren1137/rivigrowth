---
import Layout from '../layouts/Layout.astro';

const title = 'About Rivigrowth — Two Founders, Two Niches';
const description =
  'Meet the team behind Rivigrowth. SEO and content built by senior operators who do the work themselves.';
const canonical = 'https://rivigrowth.com/about';
---

<Layout title={title} description={description} canonical={canonical}>
  {/* HERO */}
  <section class="container-content pt-16 md:pt-24 pb-20 md:pb-24">
    <div class="max-w-4xl reveal">
      <p class="eyebrow eyebrow-accent mb-5">About · the team</p>
      <h1 class="h-hero">
        Two operators. <span class="italic-accent" style="color: var(--accent);">One agency.</span> No middle layer.
      </h1>
      <p class="lead mt-7 max-w-2xl">
        We built Rivigrowth so we’d never have to manage account managers again. You hire us. You talk to us. We do the work.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a href="/contact" class="btn-primary">Book a free strategy call <span aria-hidden="true">→</span></a>
        <a href="/pricing" class="btn-outline">See pricing</a>
      </div>
    </div>
  </section>

  {/* THE STORY */}
  <section class="section-cream">
    <div class="container-content py-24 md:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-4">
          <p class="eyebrow eyebrow-accent">The story</p>
          <h2 class="h-section mt-3">How we got here.</h2>
        </div>
        <div class="lg:col-span-8 space-y-6 text-[17px]" style="color: var(--text-muted);">
          <p>
            We met at a 60-person agency where we both led teams. Same pattern over and over:
            a great client signs a $5K/month retainer and gets passed to a junior who’s billing
            60% of their time across nine accounts.
          </p>
          <p>
            The work that gets done is the work the junior knows how to do — generic posts,
            template audits, recycled link strategies. The senior shows up for the QBR, nods at
            slides, disappears. Six months in, the client churns.
          </p>
          <p>
            We started Rivigrowth with one rule:
            <strong style="color: var(--text);"> the people you hire are the people who do the work.</strong>
            That’s the whole pitch. It’s why we cap at 8–10 clients between the two of us. It’s
            why we say no to anyone outside our two niches. And it’s why our retention rate is 94%.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* PRINCIPLES */}
  <section class="container-content py-24 md:py-32">
    <div class="max-w-3xl">
      <p class="eyebrow eyebrow-accent mb-4">What we believe</p>
      <h2 class="h-section">Four principles. <span class="italic-accent" style="color: var(--accent);">No exceptions.</span></h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-16">
      {[
        { n: '01', t: 'Senior people do the work', b: 'Every audit, every page, every link is touched by one of us. If we can’t do it ourselves, we don’t take it.' },
        { n: '02', t: 'Niche over generalism', b: 'Two niches, one playbook each. We say no to e-commerce, marketplaces, agencies, and anyone outside local services or SaaS.' },
        { n: '03', t: 'Counted, not promised', b: 'Every deliverable on every plan is counted. If we said 8 articles, you’ll see 8 articles in the report.' },
        { n: '04', t: 'Tell the truth, even when it loses the deal', b: 'If your business doesn’t need SEO, we tell you. If you need 12 months and only have 3, we tell you.' },
      ].map((p) => (
        <article class="card p-8">
          <p class="eyebrow eyebrow-accent">{p.n}</p>
          <h3 class="h-sub mt-3">{p.t}</h3>
          <p class="mt-3 text-[15px]" style="color: var(--text-muted);">{p.b}</p>
        </article>
      ))}
    </div>
  </section>

  {/* TEAM */}
  <section class="section-cream">
    <div class="container-content py-24 md:py-32">
      <div class="max-w-3xl">
        <p class="eyebrow eyebrow-accent mb-4">The team</p>
        <h2 class="h-section">The two people you’ll work with.</h2>
        <p class="lead mt-5">
          Two specialisms, one team. Together we cover the full SEO stack — strategy and technical execution on one side, content and conversion on the other. Both of us on every call.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-16">
        {[
          {
            tag: '01',
            role: 'Strategy, technical & link building',
            bio: 'Twelve years ranking sites in some of the most competitive niches on the internet. Owns audits, keyword strategy, technical fixes, and the backlink program.',
          },
          {
            tag: '02',
            role: 'Content, on-page & conversion',
            bio: 'Eight years writing content that ranks and sells. Owns the editorial pipeline, on-page optimization, and conversion copy.',
          },
        ].map((p) => (
          <article class="card p-8 md:p-10">
            <p class="eyebrow eyebrow-accent">{p.tag} — Rivigrowth team</p>
            <h3 class="h-sub mt-3">{p.role}</h3>
            <p class="mt-4 text-[15px]" style="color: var(--text-muted);">{p.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* FINAL CTA */}
  <section class="section-dark">
    <div class="container-content py-24 md:py-32">
      <div class="max-w-4xl">
        <p class="eyebrow eyebrow-accent mb-5">Want to talk?</p>
        <h2 class="h-section" style="color: var(--text-dark-bg);">
          If we sound like the kind of agency you want, <span class="italic-accent" style="color: var(--accent);">let’s talk.</span>
        </h2>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href="/contact" class="btn-primary">Book a free strategy call <span aria-hidden="true">→</span></a>
          <a href="/local-business" class="btn-on-dark">Local SEO</a>
          <a href="/saas" class="btn-on-dark">SaaS SEO</a>
          <a href="/pricing" class="btn-on-dark">Pricing</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
