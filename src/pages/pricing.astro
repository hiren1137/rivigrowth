---
import Layout from '../layouts/Layout.astro';
import SchemaFAQ from '../components/SchemaFAQ.astro';

const title = 'Pricing — SEO Plans From $2,000/mo | Rivigrowth';
const description =
  'Three SEO plans built for local businesses and SaaS founders. Starter from $2,000/mo, Growth at $4,000/mo, Scale at $7,000/mo. 3-month minimum, no long retainers.';
const canonical = 'https://rivigrowth.com/pricing';

const plans = [
  {
    name: 'Starter',
    price: '$2,000',
    summary: 'For founders ready to ship the first 90 days of real SEO work.',
    features: [
      ['Audit', '1 full SEO audit (month 1)'],
      ['Strategy', '90-day roadmap with priorities'],
      ['Articles', '4 articles per month'],
      ['On-page', 'Optimization for 5 key pages'],
      ['Reporting', 'Monthly performance report'],
      ['Calls', 'Monthly strategy call'],
    ],
    cta: 'Get started with Starter',
  },
  {
    name: 'Growth',
    price: '$4,000',
    tag: 'Most popular',
    highlighted: true,
    summary: 'Where most clients land. The plan that ships compounding results.',
    features: [
      ['Audit', 'Everything in Starter'],
      ['Articles', '8 articles per month'],
      ['Backlinks', '4 quality backlinks per month'],
      ['Technical', 'Ongoing technical SEO fixes'],
      ['Reporting', 'Monthly report + Slack updates'],
      ['Calls', 'Bi-weekly strategy call'],
    ],
    cta: 'Get started with Growth',
  },
  {
    name: 'Scale',
    price: '$7,000',
    summary: 'For teams ready to dominate a category and own the SERP.',
    features: [
      ['Audit', 'Everything in Growth'],
      ['Articles', '12 articles per month'],
      ['Backlinks', '10 quality backlinks per month'],
      ['Monitoring', 'Competitor + ranking monitoring'],
      ['Reporting', 'Real-time dashboard + monthly report'],
      ['Calls', 'Weekly call + dedicated Slack'],
    ],
    cta: 'Get started with Scale',
  },
];

const compareRows = [
  ['Articles per month', '4', '8', '12'],
  ['Backlinks per month', '—', '4', '10'],
  ['On-page optimization', '5 pages', 'Ongoing', 'Ongoing'],
  ['Technical SEO fixes', '—', '✓', '✓'],
  ['Strategy calls', 'Monthly', 'Bi-weekly', 'Weekly'],
  ['Slack channel', '—', 'Async', 'Dedicated'],
  ['Competitor monitoring', '—', '—', '✓'],
  ['Onboarding fee (one-time)', '$500', '$500', '$500'],
  ['Minimum commitment', '3 months', '3 months', '3 months'],
];

const faqs = [
  { question: 'Is there a long-term contract?', answer: '3-month minimum so we have time to ship something real. After that, month-to-month — leave any time, no penalty.' },
  { question: 'What\'s the onboarding fee for?', answer: 'A one-time $500 fee covers the deep audit, access setup, baseline reporting, and the kickoff strategy session.' },
  { question: 'Can I switch plans?', answer: 'Yes — upgrade or downgrade with 30 days\' notice. We\'ll prorate the change at the next billing cycle.' },
  { question: 'Do you offer one-off audits?', answer: 'Not standalone — the audit is included in every plan. Book a free strategy call first; if you only need an audit, we\'ll point you to someone who does that.' },
  { question: 'When do you start work?', answer: 'Within 5 business days of contract signing. Month 1 covers audit + strategy. Month 2 onwards is full execution.' },
  { question: 'What if my industry isn\'t local services or SaaS?', answer: 'We\'ll tell you on the strategy call. We say no a lot — depth in two niches beats spreading thin across ten.' },
];
---

<Layout title={title} description={description} canonical={canonical}>
  <SchemaFAQ slot="head" faqs={faqs} />

  {/* HERO */}
  <section class="container-content pt-16 md:pt-20 pb-12 md:pb-16">
    <div class="max-w-4xl reveal">
      <p class="eyebrow eyebrow-accent mb-5">Pricing · transparent</p>
      <h1 class="h-hero">
        Simple plans. <span class="italic-accent" style="color: var(--accent);">No retainers</span> you can’t escape.
      </h1>
      <p class="lead mt-6 max-w-2xl">
        Three plans, all built around real deliverables. Pick the one that fits today — change later, no penalty.
      </p>
    </div>
  </section>

  {/* PRICING CARDS */}
  <section class="container-content pb-24 md:pb-32">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
      {plans.map((plan) => (
        <article
          class="relative p-8 md:p-10 flex flex-col"
          style={`border: 1px solid ${plan.highlighted ? 'var(--accent)' : 'var(--border)'}; background: ${plan.highlighted ? '#FFFEFA' : 'var(--bg)'}; border-radius: 8px;`}
        >
          {plan.tag && (
            <span class="absolute -top-3 left-8 px-3 py-1 text-[11px] font-bold tracking-wider uppercase" style="background: var(--accent); color: var(--bg); border-radius: 4px;">
              {plan.tag}
            </span>
          )}
          <p class="eyebrow eyebrow-accent">{plan.name}</p>
          <p class="mt-3" style="font-family: 'Geist', sans-serif; font-weight: 700; font-size: 56px; line-height: 1; letter-spacing: -0.03em;">
            {plan.price}<span class="text-[16px] font-medium" style="color: var(--text-muted);">/mo</span>
          </p>
          <p class="mt-4 text-[14px]" style="color: var(--text-muted);">{plan.summary}</p>

          <ul class="mt-8 space-y-3 flex-1">
            {plan.features.map(([k, v]) => (
              <li class="grid grid-cols-12 gap-3 text-[14px]">
                <span class="col-span-4 eyebrow eyebrow-accent" style="font-size: 11px;">{k}</span>
                <span class="col-span-8">{v}</span>
              </li>
            ))}
          </ul>

          <a href="/contact" class={plan.highlighted ? 'btn-primary mt-10 justify-center' : 'btn-dark mt-10 justify-center'}>
            {plan.cta} <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>

    <div class="mt-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-[14px]" style="color: var(--text-muted);">
      <p>3-month minimum · $500 one-time onboarding · Cancel any time after month 3</p>
      <a href="/contact" class="link-underline font-semibold" style="color: var(--text);">Not sure which plan? Talk to us →</a>
    </div>
  </section>

  {/* COMPARE TABLE */}
  <section class="section-cream">
    <div class="container-content py-24 md:py-32">
      <div class="max-w-3xl mb-12">
        <p class="eyebrow eyebrow-accent mb-4">Compare plans</p>
        <h2 class="h-section">Side-by-side, no asterisks.</h2>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left" style="border-collapse: collapse; min-width: 640px;">
          <thead>
            <tr style="border-bottom: 1px solid var(--border);">
              <th class="py-5 pr-6 text-[13px] font-semibold uppercase tracking-wider" style="color: var(--text-muted);">Feature</th>
              <th class="py-5 px-6 text-[15px] font-bold">Starter</th>
              <th class="py-5 px-6 text-[15px] font-bold" style="color: var(--accent);">Growth</th>
              <th class="py-5 px-6 text-[15px] font-bold">Scale</th>
            </tr>
          </thead>
          <tbody>
            {compareRows.map((row) => (
              <tr style="border-bottom: 1px solid var(--border);">
                <td class="py-4 pr-6 text-[14px] font-medium">{row[0]}</td>
                <td class="py-4 px-6 text-[14px]" style="color: var(--text-muted);">{row[1]}</td>
                <td class="py-4 px-6 text-[14px] font-semibold" style="color: var(--text);">{row[2]}</td>
                <td class="py-4 px-6 text-[14px]" style="color: var(--text-muted);">{row[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* WHAT'S INCLUDED IN EVERY PLAN */}
  <section class="container-content py-24 md:py-32">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5">
        <p class="eyebrow eyebrow-accent mb-4">Every plan includes</p>
        <h2 class="h-section">Senior operators. <span class="italic-accent" style="color: var(--accent);">No junior handoffs.</span></h2>
        <p class="lead mt-5">
          Whether you’re on Starter or Scale, the same two senior operators do the work. The plans differ in volume, not in who touches your account.
        </p>
      </div>

      <ul class="lg:col-span-7 space-y-0" style="border-top: 1px solid var(--border);">
        {[
          ['Senior operators', 'The same two people own every account, every month.'],
          ['Real reporting', 'Numbers tied to revenue, not vanity dashboards.'],
          ['No long contracts', '3-month minimum, then month-to-month.'],
          ['One client per niche per city', 'For local businesses — we never compete with our own work.'],
          ['Stop any time after month 3', '30 days’ notice. No penalty, no hostage data.'],
        ].map(([k, v]) => (
          <li class="flex items-baseline gap-6 py-5" style="border-bottom: 1px solid var(--border);">
            <span class="eyebrow eyebrow-accent" style="min-width: 200px;">{k}</span>
            <span class="text-[16px]" style="color: var(--text-muted);">{v}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* FAQ */}
  <section class="section-cream">
    <div class="container-content py-24 md:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-4">
          <p class="eyebrow eyebrow-accent mb-4">FAQ · pricing</p>
          <h2 class="h-section">Pricing questions.</h2>
        </div>
        <div class="lg:col-span-8 space-y-0" style="border-top: 1px solid var(--border);">
          {faqs.map((f) => (
            <details class="py-6" style="border-bottom: 1px solid var(--border);">
              <summary class="cursor-pointer flex items-start justify-between gap-6 list-none font-semibold text-[17px]" style="color: var(--text);">
                <span>{f.question}</span>
                <span aria-hidden="true" style="color: var(--accent); font-size: 22px; line-height: 1;">+</span>
              </summary>
              <p class="mt-4 text-[15px]" style="color: var(--text-muted);">{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* FINAL CTA */}
  <section class="section-dark">
    <div class="container-content py-24 md:py-32">
      <div class="max-w-4xl">
        <p class="eyebrow eyebrow-accent mb-5">Ready to grow?</p>
        <h2 class="h-section" style="color: var(--text-dark-bg);">
          Pick a plan, or <span class="italic-accent" style="color: var(--accent);">talk to us first.</span>
        </h2>
        <p class="lead mt-6" style="color: var(--text-dark-bg-muted);">
          Free 30-minute strategy call. No deck, no pitch. We pull up your site, we tell you what we’d fix first.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href="/contact" class="btn-primary">Book a free strategy call <span aria-hidden="true">→</span></a>
          <a href="/local-business" class="btn-on-dark">See local SEO</a>
          <a href="/saas" class="btn-on-dark">See SaaS SEO</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
