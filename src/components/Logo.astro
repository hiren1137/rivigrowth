---
interface Props {
  variant?: 'light' | 'dark';
  height?: number;
  withMark?: boolean;
}

const { variant = 'light', height = 28, withMark = true } = Astro.props;
const fill = variant === 'light' ? '#0F0F0F' : '#FAFAF7';
const accent = '#D4633A';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 280 56"
  height={height}
  style={`height: ${height}px; width: auto;`}
  role="img"
  aria-label="Rivigrowth"
  fill="none"
>
  {withMark && (
    <g>
      {/* Swoosh mark — two intersecting curves forming a growth/leaf shape */}
      <path
        d="M6 38 C 14 22, 30 14, 46 28 C 50 32, 50 36, 46 40"
        stroke={fill}
        stroke-width="3"
        stroke-linecap="round"
        fill="none"
      />
      <path
        d="M14 44 C 22 30, 40 24, 50 14"
        stroke={fill}
        stroke-width="3"
        stroke-linecap="round"
        fill="none"
      />
      <circle cx="48" cy="14" r="3.5" fill={accent} />
    </g>
  )}
  <text
    x={withMark ? 68 : 0}
    y="38"
    font-family="Geist, system-ui, -apple-system, sans-serif"
    font-size="30"
    font-weight="700"
    letter-spacing="-1.2"
    fill={fill}
  >rivigrowth</text>
</svg>
